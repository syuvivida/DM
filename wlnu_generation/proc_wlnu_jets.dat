# W(-> l nu) + 0,1,2 jets, 5-flavour scheme (massless b in p and j), MLM matching.  l = e, mu, tau.
# Covers W + light/charm jets (mistags) and soft/collinear g -> b b~; hard W + b b~ comes from proc_wlnu_bb.dat
# (remove the overlap, see README).
import model sm-no_b_mass
define p = g u c d s u~ c~ d~ s~ b b~
define j = p
define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
generate p p > w+, w+ > l+ vl @0
add process p p > w-, w- > l- vl~ @0
add process p p > w+ j, w+ > l+ vl @1
add process p p > w- j, w- > l- vl~ @1
add process p p > w+ j j, w+ > l+ vl @2
add process p p > w- j j, w- > l- vl~ @2
output WLNu_jets_MET
