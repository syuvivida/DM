# Builds the tt~ gridpacks on the batch system: one job per sample (semilep, dilep, ttbb), three MET slices each.
# Submit from the ttBar directory after:  mkdir -p output error log
# Edit the two paths below if your MadGraph is somewhere else.
MGDIR                   = /eos/user/s/syu/MG5_aMC_v3_5_7
CARDS                   = $(MGDIR)/ttBar

executable              = $(CARDS)/make_ttbar_gridpacks.sh
arguments               = "$(sample)"
# HERE: where the cards and set_run_card.py are (condor runs a copy of the script in a scratch dir)
environment             = "MG=$(MGDIR) HERE=$(CARDS) NCORE=4"
getenv                  = False
output                  = output/gridpack_$(sample).$(ClusterId).out
error                   = error/gridpack_$(sample).$(ClusterId).err
log                     = log/gridpack.$(ClusterId).log
+JobFlavour             = "tomorrow"
request_cpus            = 4
request_memory          = 8000
queue sample in (semilep dilep ttbb)
