# tt~ -> (b l nu)(b~ l nu) + 0,1,2 jets (MLM), l = e, mu, tau
import model sm-no_b_mass
define p = g u c d s u~ c~ d~ s~ b b~
define j = p
define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
generate p p > t t~, (t > b w+, w+ > l+ vl), (t~ > b~ w-, w- > l- vl~) @0
add process p p > t t~ j, (t > b w+, w+ > l+ vl), (t~ > b~ w-, w- > l- vl~) @1
add process p p > t t~ j j, (t > b w+, w+ > l+ vl), (t~ > b~ w-, w- > l- vl~) @2
output TT_dilep_MET
