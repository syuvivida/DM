# tt~ b b~ (4-flavour scheme, massive b) with >= 1 leptonic W: the dominant top background with 3-4 b tags.
# No matching (ickkw = 0); the b b~ pair is regulated by ptb / drbb cuts in the run card.
import model sm
define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
define q = u c d s u~ c~ d~ s~
generate p p > t t~ b b~, (t > b w+, w+ > l+ vl), (t~ > b~ w-, w- > q q) @0
add process p p > t t~ b b~, (t > b w+, w+ > q q), (t~ > b~ w-, w- > l- vl~) @0
add process p p > t t~ b b~, (t > b w+, w+ > l+ vl), (t~ > b~ w-, w- > l- vl~) @0
output TTbb_lep_MET
