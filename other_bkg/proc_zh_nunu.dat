# Z H with Z -> nu nu~, + 0,1 jet (MLM, 5-flavour).  H is left undecayed: Pythia8 forces H -> b b~, and the job
# multiplies the cross section by BR(H -> b b~) = 0.5824.  (The loop-induced g g > Z H part is not included.)
import model sm-no_b_mass
define p = g u c d s u~ c~ d~ s~ b b~
define j = p
define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
generate p p > z h, z > vl vl~ @0
add process p p > z h j, z > vl vl~ @1
output ZH_nunubb_MET
