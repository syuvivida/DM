# Z Z -> (nu nu~)(b b~), + 0,1 jet (MLM, 5-flavour).
import model sm-no_b_mass
define p = g u c d s u~ c~ d~ s~ b b~
define j = p
define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
generate p p > z z, z > vl vl~, z > b b~ @0
add process p p > z z j, z > vl vl~, z > b b~ @1
output ZZ_nunubb_MET
